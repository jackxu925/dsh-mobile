{
  "name": "dsh-mobile",
  "version": "0.9.0",
  "description": "Mobile-native web surface for DeepSeek Harness: a phone-optimized PWA at /m that talks to the same /api as the desktop GUI — sessions, streaming, approvals, user questions. 手机原生体验的 DSH 界面。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mobile",
    "pwa"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "web",
    "cordis.patch.yml",
    "README.md"
  ]
}
